### ============================================================
### Auth — login / profile / logout
### Seed: admin.sistem | laboran | kepala.lab | peminjam @wiralab.com
### Password semua: password
### Setelah login, token disimpan ke global `token` (kulala).
### ============================================================

@baseUrl = {{baseUrl}}

### Login as admin sistem
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "device_name": "kulala"
}

> {%
client.global.set("token", response.body.token);
%}

### Login as laboran
# @name loginLaboran
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{laboranEmail}}",
  "password": "{{laboranPassword}}",
  "device_name": "kulala-laboran"
}

> {%
client.global.set("token", response.body.token);
%}

### Login as kepala lab
# @name loginKepalaLab
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{kepalaLabEmail}}",
  "password": "{{kepalaLabPassword}}",
  "device_name": "kulala-kepala"
}

> {%
client.global.set("token", response.body.token);
%}

### Login as peminjam
# @name loginPeminjam
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{peminjamEmail}}",
  "password": "{{peminjamPassword}}",
  "device_name": "kulala-peminjam"
}

> {%
client.global.set("token", response.body.token);
%}

### Login — invalid password (expect 422)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "salah",
  "device_name": "kulala"
}

### Get current authenticated user
GET {{baseUrl}}/user
Authorization: Bearer {{token}}

### Logout (revokes current token)
POST {{baseUrl}}/logout
Authorization: Bearer {{token}}
