### ============================================================
### Stock movements (ledger append-only)
### Quantity immutable setelah create; DELETE → 405
### ============================================================

@baseUrl = {{baseUrl}}
@token = {{token}}
@movementId = 1
@itemId = 1

### List stock movements
GET {{baseUrl}}/stock-movements
Authorization: Bearer {{token}}

### Filter by type
GET {{baseUrl}}/stock-movements?type=in_purchase
Authorization: Bearer {{token}}

### Filter multiple types (incoming)
GET {{baseUrl}}/stock-movements?type=in_purchase,in_return,in_adjustment
Authorization: Bearer {{token}}

### Filter outgoing
GET {{baseUrl}}/stock-movements?type=out_usage,out_borrow,out_disposal
Authorization: Bearer {{token}}

### Filter by item
GET {{baseUrl}}/stock-movements?item_id={{itemId}}
Authorization: Bearer {{token}}

### Nested — movements for item
GET {{baseUrl}}/items/{{itemId}}/stock-movements
Authorization: Bearer {{token}}

### Show movement
GET {{baseUrl}}/stock-movements/{{movementId}}
Authorization: Bearer {{token}}

### Create purchase movement
# @name createMovement
POST {{baseUrl}}/stock-movements
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "item_id": {{itemId}},
  "type": "in_purchase",
  "quantity": 25,
  "notes": "Pembelian via kulala"
}

### Create out_usage movement
POST {{baseUrl}}/stock-movements
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "item_id": {{itemId}},
  "type": "out_usage",
  "quantity": 5,
  "notes": "Pemakaian langsung"
}

### Create disposal movement
POST {{baseUrl}}/stock-movements
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "item_id": {{itemId}},
  "type": "out_disposal",
  "quantity": 2,
  "notes": "Kadaluarsa"
}

### Update notes only (OK)
PATCH {{baseUrl}}/stock-movements/{{movementId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "notes": "Catatan diperbarui"
}

### Update quantity — expect 422 (immutable)
PATCH {{baseUrl}}/stock-movements/{{movementId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 999
}

### Delete — expect 405
DELETE {{baseUrl}}/stock-movements/{{movementId}}
Authorization: Bearer {{token}}
