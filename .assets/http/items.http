### ============================================================
### Items (+ nested relations)
### ============================================================

@baseUrl = {{baseUrl}}
@token = {{token}}
@itemId = 1

### List items
GET {{baseUrl}}/items
Authorization: Bearer {{token}}

### Filter type alat
GET {{baseUrl}}/items?type=alat
Authorization: Bearer {{token}}

### Filter type bahan
GET {{baseUrl}}/items?type=bahan
Authorization: Bearer {{token}}

### Filter low stock
GET {{baseUrl}}/items?low_stock=true
Authorization: Bearer {{token}}

### Filter needs calibration
GET {{baseUrl}}/items?needs_calibration=true
Authorization: Bearer {{token}}

### Filter expired
GET {{baseUrl}}/items?expired=true
Authorization: Bearer {{token}}

### Filter condition_status (via item_units)
GET {{baseUrl}}/items?condition_status=baik
Authorization: Bearer {{token}}

### Search
GET {{baseUrl}}/items?search=mikroskop
Authorization: Bearer {{token}}

### Sort by stock_quantity desc
GET {{baseUrl}}/items?sort_by=stock_quantity&sort_order=desc&per_page=10
Authorization: Bearer {{token}}

### Show item
GET {{baseUrl}}/items/{{itemId}}
Authorization: Bearer {{token}}

### Create item
POST {{baseUrl}}/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "category_id": 1,
  "code": "NEW-KULALA-001",
  "name": "Item Uji Kulala",
  "type": "bahan",
  "unit": "botol",
  "stock_quantity": 50,
  "minimum_stock": 10,
  "location": "Ruang Lab 1",
  "condition_status": "baik",
  "manufacturer": "PT Vendor",
  "description": "Dibuat via kulala",
  "created_by": 1
}

### Update item (partial)
PATCH {{baseUrl}}/items/{{itemId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Item Updated",
  "location": "Ruang Lab 2"
}

### Delete item
DELETE {{baseUrl}}/items/{{itemId}}
Authorization: Bearer {{token}}

### Nested — stock movements
GET {{baseUrl}}/items/{{itemId}}/stock-movements
Authorization: Bearer {{token}}

### Nested — usages
GET {{baseUrl}}/items/{{itemId}}/usages
Authorization: Bearer {{token}}

### Nested — calibrations
GET {{baseUrl}}/items/{{itemId}}/calibrations
Authorization: Bearer {{token}}

### Nested — maintenances
GET {{baseUrl}}/items/{{itemId}}/maintenances
Authorization: Bearer {{token}}

### Nested — audit trails
GET {{baseUrl}}/items/{{itemId}}/audit-trails
Authorization: Bearer {{token}}

### Nested — units
GET {{baseUrl}}/items/{{itemId}}/units
Authorization: Bearer {{token}}
