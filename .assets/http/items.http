### Get all items
### Returns paginated list of items with included category and creator
GET {{baseUrl}}/items
Accept: application/json

### Get single item by ID
### Returns item with category, creator, and count fields populated
GET {{baseUrl}}/items/1
Accept: application/json

### Filter by type (alat or bahan)
GET {{baseUrl}}/items?type=alat
Accept: application/json

### Filter low stock items
GET {{baseUrl}}/items?low_stock=true
Accept: application/json

### Search items
GET {{baseUrl}}/items?search=mikroskop
Accept: application/json

### Sort by stock_quantity descending
GET {{baseUrl}}/items?sort_by=stock_quantity&sort_order=desc
Accept: application/json

### Create new item
POST {{baseUrl}}/items
Content-Type: application/json
Accept: application/json

{
  "code": "NEW-001",
  "name": "New Item Name",
  "category_id": 1,
  "unit": "pcs",
  "stock_quantity": 50,
  "minimum_stock": 10,
  "location": "Ruang Lab 1",
  "description": "Deskripsi item baru"
}

### Update item
PATCH {{baseUrl}}/items/1
Content-Type: application/json
Accept: application/json

{
  "name": "Updated Item Name",
  "stock_quantity": 75,
  "location": "Ruang Lab 2"
}

### Full update item
PUT {{baseUrl}}/items/1
Content-Type: application/json
Accept: application/json

{
  "code": "MODIFIED-001",
  "name": "Modified Item Name",
  "category_id": 1,
  "unit": "box",
  "stock_quantity": 100,
  "minimum_stock": 20,
  "location": "Gudang A",
  "manufacturer": "PT Vendor",
  "description": "Updated description"
}

### Delete item
DELETE {{baseUrl}}/items/1

### Get current authenticated user
GET {{baseUrl}}/user
Accept: application/json
