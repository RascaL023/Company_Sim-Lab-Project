### ============================================================
### Users — admin_sistem only
### Jalankan auth.http → Login as admin sistem dulu.
### ============================================================

@baseUrl = {{baseUrl}}
@token = {{token}}
@userId = 4

### List users (paginated)
GET {{baseUrl}}/users
Authorization: Bearer {{token}}

### List users — filter role peminjam
GET {{baseUrl}}/users?role=peminjam&per_page=10
Authorization: Bearer {{token}}

### List users — search
GET {{baseUrl}}/users?search=budi
Authorization: Bearer {{token}}

### Show user
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}

### Create user (peminjam)
# @name createUser
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Peminjam Kulala",
  "email": "peminjam.kulala@wiralab.com",
  "password": "rahasia123",
  "role": "peminjam",
  "phone": "081299988877",
  "is_active": true
}

### Update user (deactivate)
PATCH {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "is_active": false,
  "name": "Budi Santoso (nonaktif)"
}

### Update user (reactivate)
PATCH {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "is_active": true
}

### Delete user (jangan hapus diri sendiri)
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}
