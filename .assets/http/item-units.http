### ============================================================
### Item units (unit fisik alat)
### location_id → master locations (bukan string bebas)
### ============================================================

@baseUrl = {{baseUrl}}
@token = {{token}}
@itemUnitId = 1
@itemId = 1
@locationId = 1

### List item units
GET {{baseUrl}}/item-units
Authorization: Bearer {{token}}

### Filter by condition
GET {{baseUrl}}/item-units?condition=baik
Authorization: Bearer {{token}}

### Filter by location
GET {{baseUrl}}/item-units?location_id={{locationId}}
Authorization: Bearer {{token}}

### Filter needs calibration
GET {{baseUrl}}/item-units?needs_calibration=1
Authorization: Bearer {{token}}

### Show item unit (includes location relation)
GET {{baseUrl}}/item-units/{{itemUnitId}}
Authorization: Bearer {{token}}

### Update item unit — assign location_id
PATCH {{baseUrl}}/item-units/{{itemUnitId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "condition": "baik",
  "location_id": {{locationId}},
  "notes": "Dicek via kulala"
}

### Units for an item
GET {{baseUrl}}/items/{{itemId}}/units
Authorization: Bearer {{token}}

### Delete item unit
DELETE {{baseUrl}}/item-units/{{itemUnitId}}
Authorization: Bearer {{token}}
